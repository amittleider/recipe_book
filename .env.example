# Native iOS OAuth client from Google Cloud Console.
# Application type: iOS; bundle ID must match com.nosrecettes.app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Optional now, but useful for requesting a server auth code in a future backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-example.apps.googleusercontent.com
