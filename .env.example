# Copy to .env and fill in your Google OAuth client ID.
# Create one at https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorized JavaScript origins: your dev + GitHub Pages origins
#       e.g. http://localhost:5173 and https://<user>.github.io
# Enable the "Google Drive API" for the project.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# API key used by the Google Picker (for opening a folder shared by the other
# user). Create one at the Credentials page (Create credentials > API key) and
# enable the "Google Picker API". Restrict it to the Picker API + your origins.
VITE_GOOGLE_API_KEY=your-api-key

# Optional: your Google Cloud *project number* (not the project ID). When set,
# folders picked via the Picker are associated with this app. Safe to leave blank.
VITE_GOOGLE_APP_ID=
