{
  "name": "nos-recettes",
  "version": "2.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "pods": "env DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer BUNDLE_PATH=vendor/bundle RUBYOPT=-rlogger COCOAPODS_DISABLE_STATS=true /opt/homebrew/opt/ruby/bin/bundle exec pod install --project-directory=ios --silent",
    "ios": "expo prebuild --platform ios --no-install && npm run pods && env DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo run:ios",
    "android": "expo prebuild --platform android && expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "release:ios": "npx eas-cli build --platform ios --profile production --auto-submit",
    "submit:ios": "npx eas-cli submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@react-native-google-signin/google-signin": "^16.1.4",
    "expo": "^57.0.13",
    "expo-build-properties": "~57.0.11",
    "expo-file-system": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-secure-store": "^57.0.1",
    "expo-status-bar": "^57.0.1",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "typescript": "~6.0.3"
  }
}
